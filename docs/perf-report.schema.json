{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamespice.dev/schemas/perf-report/1.json",
  "title": "GameSpice performance report v1.1",
  "description": "One performance capture of one game process (a client or a server, native or web). Written by GSProfilerPerfReport; read by Nightly's Performance tab and by tools/perf_report_check.py. Version 1.1 (schema_minor 1) is additive over 1.0, so every 1.0 report stays valid. Keys are only ever added within a schema_version; a key that changes meaning bumps schema_version. Every list named top_* is cut to the profiler_perf_top parameter, where 0 means unlimited; a cut list says so in `truncated`.",
  "type": "object",
  "required": ["schema", "schema_version", "game_id", "build", "platform", "role", "scene", "duration_s", "frame"],
  "properties": {
    "schema": { "const": "gamespice.perf-report" },
    "schema_version": { "const": 1 },
    "schema_minor": { "type": "integer", "minimum": 0, "description": "Additive revision inside schema_version; absent means 0 (version 1.0)." },
    "made_utc": { "type": "string", "description": "ISO 8601 UTC time the report was written." },
    "game_id": { "type": "string", "minLength": 1, "description": "Stable id of the game, e.g. the repo name or pack id (fatal-contact, playlot). Never a display name." },
    "build": {
      "type": "object",
      "required": ["commit"],
      "properties": {
        "commit": { "type": "string", "description": "Full or short git commit of the game, or 'unknown'." },
        "branch": { "type": "string" },
        "version": { "type": "string" },
        "source": { "enum": ["git", "stamp", "unknown"] },
        "addons": { "type": "object", "additionalProperties": { "type": "string" }, "description": "addon folder -> commit." },
        "godot": { "type": "string" },
        "debug_build": { "type": "boolean" }
      }
    },
    "platform": { "enum": ["web", "native"] },
    "role": { "enum": ["client", "server", "standalone"], "description": "client = renders for a player; server = dedicated or sim host; standalone = both in one process (solo, bench)." },
    "scene": { "type": "string", "description": "Scene or mode the capture ran in (res:// path or a game's own name)." },
    "map": { "type": "string" },
    "bots": { "type": "integer", "minimum": 0 },
    "players": { "type": "integer", "minimum": 0 },
    "resolution": { "type": "string", "pattern": "^[0-9]+x[0-9]+$", "description": "Window or render size, 'WxH'; '0x0' when headless." },
    "gpu": { "type": "string", "description": "RenderingServer adapter name; empty when headless." },
    "cpu": { "type": "string" },
    "os": { "type": "string" },
    "renderer": { "type": "string" },
    "tick_rate": { "type": "integer" },
    "duration_s": { "type": "number", "minimum": 0 },
    "tags": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Free labels a runner adds (box, run id, ab arm)." },

    "frame": {
      "type": "object",
      "required": ["count", "ms"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "ms": { "$ref": "#/$defs/stat", "description": "Whole-frame wall time." },
        "fps_avg": { "type": "number" },
        "budget_ms": { "type": "number" },
        "over_budget": { "type": "integer", "description": "Frames longer than budget_ms." },
        "phases": {
          "type": "object",
          "description": "Engine phases, ms per frame.",
          "properties": { "physics": { "$ref": "#/$defs/stat" }, "script": { "$ref": "#/$defs/stat" }, "render": { "$ref": "#/$defs/stat" }, "wait": { "$ref": "#/$defs/stat" } }
        },
        "render_cpu_ms": { "$ref": "#/$defs/stat" },
        "render_gpu_ms": { "$ref": "#/$defs/stat" }
      }
    },

    "tick": {
      "type": "object",
      "description": "Physics/simulation tick cost, the server's per-tick breakdown lives in budget[] under the physics.* and sim.* groups.",
      "properties": {
        "rate": { "type": "number" },
        "ticks": { "type": "integer" },
        "dropped": { "type": "integer" },
        "catch_up_frames": { "type": "integer" },
        "budget_ms": { "type": "number" },
        "ms": { "$ref": "#/$defs/stat" }
      }
    },

    "budget": {
      "type": "array",
      "description": "Hierarchical budget groups, the VPROF budget panel equivalent. id is a stable dotted name '<group>.<sub>' ('physics.scripts', 'net.snapshot'); parent is the id one level up or ''. Costliest first within a parent.",
      "items": {
        "type": "object",
        "required": ["id", "ms_per_frame"],
        "properties": {
          "id": { "type": "string" },
          "parent": { "type": "string" },
          "path": { "type": "string", "description": "The profiler tree path the row came from, frames joined by ';' (one id can appear under two parents)." },
          "addon": { "type": "string", "description": "Addon or game the id is attributed to (gs-net, gs-player-controller, game)." },
          "ms_per_frame": { "type": "number" },
          "self_ms_per_frame": { "type": "number" },
          "pct_frame": { "type": "number", "description": "Percent of the average frame." },
          "pct_budget": { "type": "number", "description": "Percent of the frame or tick budget it is held against." },
          "p95_ms": { "type": "number" },
          "max_ms": { "type": "number" },
          "calls_per_frame": { "type": "number" },
          "per": { "enum": ["frame", "tick"] },
          "what": { "type": "string", "description": "What the worst call was doing." }
        }
      }
    },

    "addons": {
      "type": "array",
      "description": "Per-addon attribution: the budget rows summed by the addon that owns them.",
      "items": {
        "type": "object",
        "required": ["addon", "ms_per_frame"],
        "properties": {
          "addon": { "type": "string" },
          "ms_per_frame": { "type": "number" },
          "pct_frame": { "type": "number" },
          "top": { "type": "array", "items": { "type": "string" }, "description": "Its costliest budget ids." }
        }
      }
    },

    "hitches": {
      "type": "array",
      "description": "Frames far over budget or over the running average, worst first, each with the responsible stack.",
      "items": {
        "type": "object",
        "required": ["t", "ms", "cause"],
        "properties": {
          "t": { "type": "number", "description": "Seconds from the start of the capture." },
          "ms": { "type": "number" },
          "cause": { "type": "string", "description": "System id or engine.<phase>." },
          "what": { "type": "string" },
          "stack": { "type": "array", "items": { "type": "string" }, "description": "Costliest span paths in that frame, 'frame;physics;scripts;x', self ms in `stack_ms`." },
          "stack_ms": { "type": "array", "items": { "type": "number" } },
          "phases": { "type": "object", "additionalProperties": { "type": "number" } },
          "hints": { "type": "array", "items": { "type": "string" } },
          "period": { "type": "string", "description": "'every 0.50 s' when the cause repeats." }
        }
      }
    },

    "render": {
      "type": "object",
      "properties": {
        "draw_calls": { "$ref": "#/$defs/stat" },
        "primitives": { "$ref": "#/$defs/stat" },
        "objects": { "$ref": "#/$defs/stat" },
        "texture_mb": { "type": "number" },
        "buffer_mb": { "type": "number" },
        "video_mb": { "type": "number" },
        "cost_estimate": { "type": "object", "description": "Present when top_draw rows carry est_cost: an ESTIMATE, not a measurement.", "properties": { "method": { "type": "string" }, "note": { "type": "string" } } },
        "gpu": {
          "type": "object",
          "description": "Measured GPU time (v1.1, optional). source is measured or unavailable (web, Compatibility, headless; then why says so and only the estimate exists). viewports: [{name, gpu_ms, cpu_ms}]; passes: [{name, avg_ms, max_ms, frames}]. Per-material GPU time does not exist in the engine: top_draw rows carry est_gpu_ms, an estimate shared by est_draws.",
          "properties": { "source": { "type": "string", "enum": ["measured", "unavailable"] }, "why": { "type": "string" }, "frames": { "type": "integer" }, "viewports": { "type": "array" }, "passes": { "type": "array" }, "basis": { "type": "string" } }
        },
        "top_draw": {
          "type": "array",
          "description": "Draw/triangle attribution top-N from a snapshot at the end of the capture. kind: material, mesh or node_class.",
          "items": {
            "type": "object",
            "required": ["kind", "name", "instances"],
            "properties": {
              "kind": { "enum": ["material", "mesh", "node_class", "group"] },
              "name": { "type": "string" },
              "instances": { "type": "integer" },
              "surfaces": { "type": "integer" },
              "triangles": { "type": "integer" },
              "est_draws": { "type": "integer", "description": "Instances x surfaces: an upper bound on draw calls before batching and culling." },
              "est_cost": { "type": "number", "description": "ESTIMATE of relative cost where GPU time per material is unavailable: est_draws plus triangles weighted per draw call. Compare rows with each other, not with milliseconds." },
              "est_gpu_ms": { "type": "number", "description": "Estimate, not a timer: the measured frame GPU ms shared by est_draws (v1.1, only when render.gpu.source is measured)." }
            }
          }
        }
      }
    },

    "memory": {
      "type": "object",
      "properties": {
        "static_mb": { "type": "object", "properties": { "start": { "type": "number" }, "end": { "type": "number" }, "peak": { "type": "number" } } },
        "video_mb": { "type": "object", "properties": { "start": { "type": "number" }, "end": { "type": "number" } } },
        "wasm_heap_mb": { "type": "object", "description": "Web only: JS/wasm heap, if the browser reports it.", "properties": { "start": { "type": "number" }, "end": { "type": "number" } } },
        "objects": { "type": "object", "properties": { "start": { "type": "integer" }, "end": { "type": "integer" } } },
        "nodes": { "type": "object", "properties": { "start": { "type": "integer" }, "end": { "type": "integer" } } },
        "orphan_nodes": { "type": "object", "properties": { "start": { "type": "integer" }, "end": { "type": "integer" } } },
        "growth_per_min": { "type": "object", "additionalProperties": { "type": "number" } },
        "top_classes": {
          "type": "array",
          "description": "Node/object classes by live count at the end, with growth over the capture.",
          "items": { "type": "object", "required": ["class", "count"], "properties": { "class": { "type": "string" }, "count": { "type": "integer" }, "delta": { "type": "integer" } } }
        },
        "top_allocs": {
          "type": "array",
          "description": "Named allocation counters a game reported (GSProfilerCounts): what creates objects, per frame.",
          "items": { "type": "object", "required": ["name", "total"], "properties": { "name": { "type": "string" }, "total": { "type": "integer" }, "per_frame": { "type": "number" } } }
        }
      }
    },

    "signals": {
      "type": "object",
      "description": "Signal fan-out from GSProfilerSignals: emits times receivers, most deliveries first; cut to profiler_perf_signal_top.",
      "properties": {
        "fanout": {
          "type": "array",
          "items": { "type": "object", "required": ["signal", "emits", "deliveries"], "properties": { "signal": { "type": "string" }, "emits": { "type": "integer", "minimum": 0 }, "receivers_max": { "type": "integer", "minimum": 0 }, "receivers_avg": { "type": "number" }, "deliveries": { "type": "integer", "minimum": 0 }, "deliveries_per_s": { "type": "number" } } }
        }
      }
    },

    "network": {
      "type": "object",
      "properties": {
        "in_kbps": { "$ref": "#/$defs/stat" },
        "out_kbps": { "$ref": "#/$defs/stat" },
        "by_class": {
          "type": "array",
          "description": "Network cost per message or entity class, from GSProfilerNetCost.add(class, bytes).",
          "items": {
            "type": "object",
            "required": ["class", "bytes"],
            "properties": {
              "class": { "type": "string" },
              "dir": { "enum": ["in", "out"] },
              "bytes": { "type": "integer" },
              "messages": { "type": "integer" },
              "bytes_per_s": { "type": "number" },
              "messages_per_s": { "type": "number" },
              "max_bytes": { "type": "integer", "description": "Largest single message." }
            }
          }
        }
      }
    },

    "physics": {
      "type": "object",
      "properties": {
        "active_bodies": { "$ref": "#/$defs/stat" },
        "pairs": { "$ref": "#/$defs/stat" },
        "islands": { "$ref": "#/$defs/stat" },
        "top_queries": {
          "type": "array",
          "items": { "type": "object", "required": ["system", "kind", "ms_per_frame"], "properties": { "system": { "type": "string" }, "kind": { "type": "string" }, "ms_per_frame": { "type": "number" }, "calls_per_frame": { "type": "number" }, "us_per_call": { "type": "number" } } }
        }
      }
    },

    "script": {
      "type": "object",
      "description": "Script versus native split and the costliest functions.",
      "properties": {
        "script_ms_per_frame": { "type": "number" },
        "native_ms_per_frame": { "type": "number", "description": "physics + render + wait + unattributed engine time per frame." },
        "script_pct": { "type": "number" },
        "top_functions": {
          "type": "array",
          "items": { "type": "object", "required": ["name", "self_ms_per_frame"], "properties": { "name": { "type": "string" }, "path": { "type": "string" }, "self_ms_per_frame": { "type": "number" }, "total_ms_per_frame": { "type": "number" }, "calls_per_frame": { "type": "number" }, "us_per_call": { "type": "number" } } }
        }
      }
    },

    "counters": {
      "type": "object",
      "description": "Always-on cheap counters a game or addon reports (GSProfilerCounts): name -> totals.",
      "additionalProperties": { "type": "object", "properties": { "total": { "type": "integer" }, "per_frame": { "type": "number" }, "per_tick": { "type": "number" } } }
    },

    "loading": {
      "type": "array",
      "description": "Asset loads and stalls: anything that took longer than profiler_load_min_ms, slowest first.",
      "items": { "type": "object", "required": ["name", "ms"], "properties": { "name": { "type": "string" }, "kind": { "type": "string" }, "ms": { "type": "number" }, "t": { "type": "number" } } }
    },

    "baseline": {
      "type": "object",
      "description": "What changed since the reference report (profiler_perf_baseline): rows that moved beyond the noise floor. 1.1 adds the reference's commit and time, counts and a direction per row.",
      "properties": {
        "against": { "type": "string", "description": "Commit or file the reference report came from." },
        "noise_pct": { "type": "number" },
        "against_commit": { "type": "string" },
        "against_made_utc": { "type": "string" },
        "compared": { "type": "integer", "minimum": 0, "description": "Numbers compared, changed or not." },
        "worse": { "type": "integer", "minimum": 0 },
        "better": { "type": "integer", "minimum": 0 },
        "changed": {
          "type": "array",
          "items": { "type": "object", "required": ["key", "a", "b"], "properties": { "key": { "type": "string" }, "a": { "type": "number" }, "b": { "type": "number" }, "delta": { "type": "number" }, "pct": { "type": "number" }, "direction": { "enum": ["worse", "better"] } } }
        }
      }
    },

    "truncated": { "type": "object", "additionalProperties": { "type": "integer" }, "description": "list name -> how many rows were cut by profiler_perf_top (absent when nothing was cut)." },
    "overhead_ms_per_frame": { "type": "number", "description": "The profiler's own cost while capturing." },
    "notes": { "type": "array", "items": { "type": "string" }, "description": "Sections that could not be collected on this platform/build, each with the reason. A missing section is explained here, never silent." }
  },

  "$defs": {
    "stat": {
      "type": "object",
      "required": ["avg", "max"],
      "properties": {
        "min": { "type": "number" }, "avg": { "type": "number" }, "p50": { "type": "number" },
        "p95": { "type": "number" }, "p99": { "type": "number" }, "max": { "type": "number" }
      }
    }
  }
}
