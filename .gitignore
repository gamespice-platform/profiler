# Godot 4
.godot/
/android/

# The addons this one uses are separate repositories. For local development, symlink them:
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
# gs_core is the addon's only dependency; the menu demo also links gs-menu and its own.
/addons/gs_core
/addons/gs_menu
/addons/gs_ui
/addons/gs_input
/addons/gs_settings
/addons/gs_profile
# The server suite section uses a real gs-server console and gs-server-query snapshot.
/addons/gs_server
/addons/gs_server_query
# Never tracked: whatever else a tool links here belongs to that tool's run.
/addons/gs_auth
/addons/gs_cloud
/addons/gs_moderation
/addons/gs_sql
/addons/gs_stats
/addons/gs_voice
# gs_settings stores through gs-save's GSSaveStoreFile; the menu page needs it to parse.
/addons/gs_save

# Rendered frames are looked at, not kept.
/screenshots/

# Exports
build/
export_presets.cfg

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
__pycache__/
